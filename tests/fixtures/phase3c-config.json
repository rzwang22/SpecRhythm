{
  "schema_version": "specrhythm.phase3c-config.v1",
  "runtime": {
    "schema_version": "specrhythm.phase3-config.v1",
    "backend": "dry-run",
    "draft": {"model_path": "draft", "gpu_ids": [0], "tp_size": 1},
    "target": {"model_path": "target", "gpu_ids": [1, 2], "tp_size": 2},
    "context_length": 1024,
    "batch_size": 1,
    "search_pool_size": 64,
    "candidate_budget": 4,
    "candidate_width": 2,
    "max_new_tokens": 4,
    "random_seed": 1664,
    "sampling_configuration": {"do_sample": false}
  },
  "workload": {
    "arrival_trace": "phase3c-arrivals.jsonl",
    "tokenizer_model": "draft",
    "request_count": 5,
    "maximum_new_tokens": 4,
    "time_scale": 1.0,
    "sources": {
      "code": {"dataset": "HumanEval", "adapter": "humaneval", "path": "phase3c-humaneval.jsonl", "split": "test", "source_license_or_url": "fixture://humaneval"},
      "chat": {"dataset": "ShareGPT", "adapter": "sharegpt", "path": "phase3c-sharegpt.jsonl", "split": "train", "source_license_or_url": "fixture://sharegpt"},
      "summarization": {"dataset": "CNN-DailyMail", "adapter": "cnn_dailymail", "path": "phase3c-cnndm.jsonl", "split": "test", "source_license_or_url": "fixture://cnn-dailymail"}
    }
  },
  "candidate_pool": {
    "phase2_config_path": "../../configs/simulator.json",
    "ratios": [1, 2, 4],
    "verification_budget": 4
  }
}
